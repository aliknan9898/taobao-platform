{
 "name": "Kinan Shop",
 "short_name": "Kinan Shop",
 "id": "/",
 "start_url": "/",
 "scope": "/",
 "display": "standalone",
 "description": "Shop many sellers in one place, delivered to your door.",
 "background_color": "#ffffff",
 "theme_color": "#ffffff",
 "icons": [
  {
   "src": "/assets/icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "/assets/icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "/assets/icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "related_applications": [
  {
   "platform": "webapp",
   "url": "https://kinan.shop/assets/shop.webmanifest"
  }
 ],
 "prefer_related_applications": false
}