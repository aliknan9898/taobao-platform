     "version": {
      "type": "integer"
     },
     "currency": {
      "type": "string"
     },
     "expires_at": {
      "type": "string",
      "format": "date-time"
     },
     "created_at": {
      "type": "string",
      "format": "date-time"
     },
     "destination": {
      "$ref": "#/components/schemas/Destination"
     },
     "items": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Line"
      }
     },
     "totals": {
      "$ref": "#/components/schemas/Totals"
     },
