    "additionalProperties": false
   },
   "Order": {
    "type": "object",
    "required": [
     "order_id",
     "external_order_ref",
     "quote_id",
     "version",
     "status",
     "currency",
     "items",
     "totals",
     "ship_to",
     "created_at",
     "updated_at",
     "links"
    ],
    "properties": {
     "order_id": {
      "type": "string"
     },
     "external_order_ref": {
      "type": "string"
     },
     "quote_id": {
      "type": "string"
     },
     "version": {
      "type": "integer"
     },
     "status": {
      "type": "object",
      "required": [
       "payment",
       "fulfillment"
