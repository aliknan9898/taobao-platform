       "live"
      ]
     },
     "organization": {
      "type": "object",
      "required": [
       "id",
       "name"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       }
      },
      "additionalProperties": false
     },
     "store": {
      "type": "object",
      "required": [
       "id",
       "name",
       "platform"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "platform": {
        "type": "string"
       }
      },
      "additionalProperties": false
     },
     "scopes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "markets": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "locales": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "currencies": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "price_list": {
      "type": "object",
      "required": [
       "version",
       "currency"
      ],
      "properties": {
       "version": {
        "type": "integer"
       },
       "currency": {
        "type": "string"
       }
      },
      "additionalProperties": false
     },
     "api_version": {
      "type": "string",
      "const": "v1"
     }
    },
    "additionalProperties": false
   },
   "Problem": {
    "type": "object",
    "required": [
     "type",
     "title",
     "status",
     "code",
     "request_id"
    ],
    "properties": {
     "type": {
      "type": "string",
      "format": "uri"
     },
     "title": {
      "type": "string"
     },
     "status": {
      "type": "integer"
     },
     "code": {
      "type": "string",
      "enum": [
       "INVALID_INPUT",
       "INVALID_CURSOR",
       "CURSOR_SCOPE_MISMATCH",
       "INVALID_CREDENTIAL",
       "INSUFFICIENT_SCOPE",
       "RESOURCE_NOT_FOUND",
       "METHOD_NOT_ALLOWED",
       "CURSOR_EXPIRED",
       "UNSUPPORTED_DESTINATION",
       "RATE_LIMITED",
       "TEMPORARILY_UNAVAILABLE",
       "INTERNAL",
       "QUOTE_EXPIRED",
       "QUOTE_MISMATCH",
       "STOCK_CHANGED",
       "IDEMPOTENCY_CONFLICT",
       "ORDER_REFERENCE_CONFLICT",
       "BASKET_NOT_ELIGIBLE",
       "INVALID_STATE"
      ]
     },
     "request_id": {
      "type": "string"
     },
     "detail": {
      "type": "string"
     },
     "errors": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "field",
        "code"
       ],
       "properties": {
        "field": {
         "type": "string"
        },
        "code": {
         "type": "string"
        },
        "detail": {
         "type": "string"
        }
       },
       "additionalProperties": false
      }
     }
    },
    "additionalProperties": false
   },
   "Destination": {
    "type": "object",
    "required": [
     "country",
     "postal_code"
    ],
    "properties": {
     "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
     },
     "postal_code": {
      "type": "string"
     }
    },
    "additionalProperties": false
   },
   "QuoteRequest": {
    "type": "object",
    "required": [
     "currency",
     "destination",
     "items"
    ],
    "properties": {
     "currency": {
      "type": "string",
      "const": "EUR"
     },
     "destination": {
      "$ref": "#/components/schemas/Destination"
     },
     "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
       "type": "object",
       "required": [
        "variant_id",
        "quantity"
       ],
       "properties": {
        "variant_id": {
         "type": "string"
        },
        "quantity": {
         "type": "integer",
         "minimum": 1,
         "maximum": 999
        }
       },
       "additionalProperties": false
      }
     }
    },
    "additionalProperties": false
   },
