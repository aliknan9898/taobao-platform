    "properties": {
     "variant_id": {
      "type": "string"
     },
     "product_id": {
      "type": "string"
     },
     "quantity": {
      "type": "integer"
     },
     "unit_ex_tax_minor": {
      "type": "integer"
     },
     "line_ex_tax_minor": {
      "type": "integer"
