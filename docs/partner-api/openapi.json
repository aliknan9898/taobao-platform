     "shipping_ex_tax_minor": {
      "type": "integer",
      "minimum": 0
     },
     "duties_minor": {
      "type": "integer",
      "minimum": 0
     },
     "handling_minor": {
      "type": "integer",
      "minimum": 0
     },
     "tax_minor": {
      "type": "integer",
      "minimum": 0
     },
     "payable_minor": {
      "type": "integer",
      "minimum": 0
     }
    },
    "additionalProperties": false
   },
