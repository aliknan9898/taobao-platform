         "on_hold",
         "confirmed",
         "processing",
         "partially_shipped",
         "shipped",
         "delivered",
         "cancelled",
         "exception"
        ]
       }
      },
      "additionalProperties": false
     },
     "currency": {
      "type": "string"
     },
     "items": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Line"
      }
     },
     "totals": {
      "$ref": "#/components/schemas/Totals"
     },
     "ship_to": {
      "type": "object",
      "properties": {
       "recipient": {
        "type": [
         "string",
         "null"
        ]
       },
       "city": {
        "type": [
         "string",
         "null"
        ]
       },
       "postal_code": {
        "type": [
         "string",
         "null"
        ]
       },
       "country": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "additionalProperties": false
     },
     "created_at": {
      "type": "string",
      "format": "date-time"
     },
     "updated_at": {
      "type": "string",
      "format": "date-time"
     },
     "links": {
      "type": "object",
      "properties": {
       "self": {
        "type": "string"
       }
      },
      "additionalProperties": false
     }
