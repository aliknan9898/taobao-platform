     "city": {
      "type": "string"
     },
     "region": {
      "type": "string"
     },
     "postal_code": {
      "type": "string"
     },
     "country": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     },
     "email": {
      "type": "string"
     }
