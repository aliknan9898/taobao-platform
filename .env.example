# ===== Taobao Global Open Platform (one app; every seller connects their own account) =====
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_API_URL=https://api.taobao.global/rest
TAOBAO_AUTH_URL=https://api.taobao.global/oauth/authorize

# Must match the app's Callback URL on the platform: PUBLIC_BASE_URL/oauth/callback
PUBLIC_BASE_URL=https://your-domain.com
PORT=3000

# ===== Database (Render: kinan-db → Connect → Internal Database URL). Without it, data is kept in JSON files =====
DATABASE_URL=

# ===== Email (Brevo free plan: create an API key and verify the sender address) =====
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Kinan

# ===== Couriers (optional): live prices and labels in the warehouse app =====
# DHL Express — MyDHL API (developer.dhl.com). DHL_TEST=1 uses the sandbox.
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT=
DHL_TEST=
# Aramex — Shipping API v2 (account from your Aramex sales contact)
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT=
ARAMEX_PIN=
ARAMEX_ENTITY=
ARAMEX_COUNTRY=

# Customers can ask for a return within this many days of delivery; sellers can withdraw from this amount
RETURN_DAYS=14
MIN_WITHDRAWAL=10

# ===== Stripe (leave empty for demo mode) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_…) — used by the buyer website to collect card payments
STRIPE_PUBLISHABLE_KEY=
SALE_CURRENCY=usd
# Exchange rate for suggested prices: how many CNY per 1 unit of the sale currency
CNY_PER_SALE_UNIT=7.2
SHIPPING_FLAT_FEE=8
PLATFORM_COMMISSION_PCT=10

# ===== Sign in with Google (optional) =====
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: PUBLIC_BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail addresses that may open /admin with Google (ADMIN_EMAIL is always allowed). Comma-separated.
ADMIN_GOOGLE_EMAILS=

# ===== AliExpress (optional) — products ship straight to the customer =====
# Without these, AliExpress products still work in manual mode (you order them on AliExpress by hand).
# App callback URL on openservice.aliexpress.com: PUBLIC_BASE_URL/oauth/aliexpress/callback
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# ALIEXPRESS_SHIPPING_SERVICE=CAINIAO_STANDARD
# ALIEXPRESS_DELIVERY_DAYS=10–20

# ===== First admin account (created on first start) =====
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== Your China warehouse (all Taobao orders ship here) =====
WAREHOUSE_NAME=
WAREHOUSE_MOBILE=
WAREHOUSE_STATE=
WAREHOUSE_CITY=
WAREHOUSE_DISTRICT=
WAREHOUSE_DETAIL=
WAREHOUSE_ZIP=

ORDER_SYNC_MINUTES=15

# ---- Added features (all optional) ----
# Exchange rates refresh daily from open.er-api.com. Fixed rate instead: CNY_PER_SALE_UNIT=7.2
FX_CNY_BUFFER_PCT=2
# Buy for me
BFM_FEE_PCT=10
BFM_MIN_FEE=2
BFM_CHINA_SHIP_CNY=10
# Arabic product translation (one of)
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
# Packing / storage
PACKAGING_PROTECT_FEE=2
STORAGE_DAYS=30
# Referral reward (wallet credit)
REFERRAL_REWARD=5
# Owner alerts on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp help button (international format, digits only)
WHATSAPP_NUMBER=
# Phone notifications: keys are created automatically; set to pin them
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Nightly backup email (default: first admin Gmail)
BACKUP_EMAIL=
# Google Search Console + analytics (loaded only after cookie consent)
GOOGLE_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
CLARITY_PROJECT_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
# Store links for the download page (when the apps are in the stores)
SHOP_ANDROID_URL=
SHOP_IOS_URL=
SELLER_ANDROID_URL=
SELLER_IOS_URL=

# ---- CJdropshipping (optional) ----
# Products from CJ ship straight to the customer. Kinan creates and pays the CJ order from your CJ balance.
# CJ account → Authorization → API → generate the API key. Test payments always make CJ *sandbox* orders.
CJ_API_KEY=
# CJ_FALLBACK_SHIPPING=8      # shipping charged if CJ's price service is down
# CJ_SANDBOX=1                # make every CJ order a sandbox order (for testing with real payments off)

# AI: product review and listing assistant. GEMINI_API_KEY is free from aistudio.google.com (used first);
# ANTHROPIC_API_KEY (console.anthropic.com) is paid. With either key every product is reviewed automatically.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini            # or claude, when both keys are set
# AI_AUTO_REVIEW=off            # stop the automatic review
# AI_REVIEW_DAILY=300           # products reviewed per day at most
# AI_REVIEW_CONCURRENCY=2       # simultaneous product reviews (1–4)
# AI_REVIEW_GAP_MS=8000          # wait between batches
# ---- Native apps (optional) ----
# Expo push for the iPhone/Android apps: only needed if "enhanced push security" is on in the Expo account
EXPO_ACCESS_TOKEN=
# Days after which name, phone and street are removed from orders of DELETED customer accounts (empty = keep). Ask your accountant.
ORDER_PII_RETENTION_DAYS=
# Sign-in from the iPhone/Android apps (off until set)
# Google: OAuth client ids of type iOS / Android from Google Cloud Console (the web client GOOGLE_CLIENT_ID is accepted too)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Apple: the iOS bundle id; for revoking Apple sign-in when a customer deletes the account also the team id, key id and .p8 key
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Product photos on Kinan's own storage (Cloudflare R2), so customers never load images from supplier servers (off until set)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public address of the bucket (custom domain on the bucket), e.g. https://img.kinan.shop
R2_PUBLIC_URL=

# Instagram connection check (server only).
INSTAGRAM_ACCESS_TOKEN=
# Leave blank for a tester token. Set the Instagram account ID for a Unified Login system-user token.
INSTAGRAM_ACCOUNT_ID=

# KINAN Admin advertising reports. Keep API tokens on the server.
# Meta Marketing API token with ads_read and access to this ad account.
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
# TikTok API for Business token with reporting access to this advertiser.
TIKTOK_ADS_ADVERTISER_ID=
TIKTOK_ADS_ACCESS_TOKEN=
# Google Ads reuses the existing Keyword Planner OAuth connection and developer token.

# Error reporting (optional). Sentry → Settings → Projects → <project> → Client Keys (DSN). Off when empty.
# Sends error type, message, stack, method and path only; e-mails, phones, card numbers and secrets are scrubbed.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# eBay Publisher (leave publication switched off until sandbox verification)
EBAY_ENV=sandbox
EBAY_PUBLISH_ENABLED=0
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_REFRESH_TOKEN=
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=https://kinan.shop/webhooks/ebay/deletion
EBAY_MARKETPLACE=EBAY_GB
EBAY_MERCHANT_LOCATION_KEY=KINAN_MALTA_HQ
EBAY_CATEGORY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
# Set address line and phone privately before --execute; other fields override Malta defaults:
# EBAY_LOC_ADDRESS1=
# EBAY_LOC_CITY=
# EBAY_LOC_POSTAL=
# EBAY_LOC_COUNTRY=
# EBAY_LOC_PHONE=
