# ===== Taobao Global Open Platform (one app; every seller connects their own account) =====
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_API_URL=https://api.taobao.global/rest
TAOBAO_AUTH_URL=https://api.taobao.global/oauth/authorize

# Must match the app's Callback URL on the platform: PUBLIC_BASE_URL/oauth/callback
PUBLIC_BASE_URL=https://your-domain.com
PORT=3000

# ===== Database (Render: kinan-db → Connect → Internal Database URL). Without it, data is kept in JSON files =====
DATABASE_URL=

# ===== Email (Brevo free plan: create an API key and verify the sender address) =====
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Kinan

# Customers can ask for a return within this many days of delivery; sellers can withdraw from this amount
RETURN_DAYS=14
MIN_WITHDRAWAL=10

# ===== Stripe (leave empty for demo mode) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_…) — used by the buyer website to collect card payments
STRIPE_PUBLISHABLE_KEY=
SALE_CURRENCY=usd
# Exchange rate for suggested prices: how many CNY per 1 unit of the sale currency
CNY_PER_SALE_UNIT=7.2
SHIPPING_FLAT_FEE=8
PLATFORM_COMMISSION_PCT=10

# ===== Sign in with Google (optional) =====
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: PUBLIC_BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail addresses that may open /admin with Google (ADMIN_EMAIL is always allowed). Comma-separated.
ADMIN_GOOGLE_EMAILS=

# ===== AliExpress (optional) — products ship straight to the customer =====
# Without these, AliExpress products still work in manual mode (you order them on AliExpress by hand).
# App callback URL on openservice.aliexpress.com: PUBLIC_BASE_URL/oauth/aliexpress/callback
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# ALIEXPRESS_SHIPPING_SERVICE=CAINIAO_STANDARD
# ALIEXPRESS_DELIVERY_DAYS=10–20

# ===== First admin account (created on first start) =====
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== Your China warehouse (all Taobao orders ship here) =====
WAREHOUSE_NAME=
WAREHOUSE_MOBILE=
WAREHOUSE_STATE=
WAREHOUSE_CITY=
WAREHOUSE_DISTRICT=
WAREHOUSE_DETAIL=
WAREHOUSE_ZIP=

ORDER_SYNC_MINUTES=15
