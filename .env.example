# ===== Taobao Global Open Platform (one app; every seller connects their own account) =====
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_API_URL=https://api.taobao.global/rest
TAOBAO_AUTH_URL=https://api.taobao.global/oauth/authorize

# Must match the app's Callback URL on the platform: PUBLIC_BASE_URL/oauth/callback
PUBLIC_BASE_URL=https://your-domain.com
PORT=3000

# ===== Database (Render: kinan-db → Connect → Internal Database URL). Without it, data is kept in JSON files =====
DATABASE_URL=

# ===== Email (Brevo free plan: create an API key and verify the sender address) =====
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Kinan

# ===== Couriers (optional): live prices and labels in the warehouse app =====
# DHL Express — MyDHL API (developer.dhl.com). DHL_TEST=1 uses the sandbox.
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT=
DHL_TEST=
# Aramex — Shipping API v2 (account from your Aramex sales contact)
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT=
ARAMEX_PIN=
ARAMEX_ENTITY=
ARAMEX_COUNTRY=

# Customers can ask for a return within this many days of delivery; sellers can withdraw from this amount
RETURN_DAYS=14
MIN_WITHDRAWAL=10

# ===== Stripe (leave empty for demo mode) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_…) — used by the buyer website to collect card payments
STRIPE_PUBLISHABLE_KEY=
SALE_CURRENCY=usd
# Exchange rate for suggested prices: how many CNY per 1 unit of the sale currency
CNY_PER_SALE_UNIT=7.2
SHIPPING_FLAT_FEE=8
PLATFORM_COMMISSION_PCT=10

# ===== Sign in with Google (optional) =====
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: PUBLIC_BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail addresses that may open /admin with Google (ADMIN_EMAIL is always allowed). Comma-separated.
ADMIN_GOOGLE_EMAILS=

# ===== AliExpress (optional) — products ship straight to the customer =====
# Without these, AliExpress products still work in manual mode (you order them on AliExpress by hand).
# App callback URL on openservice.aliexpress.com: PUBLIC_BASE_URL/oauth/aliexpress/callback
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# ALIEXPRESS_SHIPPING_SERVICE=CAINIAO_STANDARD
# ALIEXPRESS_DELIVERY_DAYS=10–20

# ===== First admin account (created on first start) =====
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== Your China warehouse (all Taobao orders ship here) =====
WAREHOUSE_NAME=
WAREHOUSE_MOBILE=
WAREHOUSE_STATE=
WAREHOUSE_CITY=
WAREHOUSE_DISTRICT=
WAREHOUSE_DETAIL=
WAREHOUSE_ZIP=

ORDER_SYNC_MINUTES=15

# ---- Added features (all optional) ----
# Exchange rates refresh daily from open.er-api.com. Fixed rate instead: CNY_PER_SALE_UNIT=7.2
FX_CNY_BUFFER_PCT=2
# Buy for me
BFM_FEE_PCT=10
BFM_MIN_FEE=2
BFM_CHINA_SHIP_CNY=10
# Arabic product translation (one of)
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
# Packing / storage
PACKAGING_PROTECT_FEE=2
STORAGE_DAYS=30
# Referral reward (wallet credit)
REFERRAL_REWARD=5
# Owner alerts on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp help button (international format, digits only)
WHATSAPP_NUMBER=
# Phone notifications: keys are created automatically; set to pin them
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Nightly backup email (default: first admin Gmail)
BACKUP_EMAIL=
# Google Search Console + analytics (loaded only after cookie consent)
GOOGLE_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
CLARITY_PROJECT_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
# Store links for the download page (when the apps are in the stores)
SHOP_ANDROID_URL=
SHOP_IOS_URL=
SELLER_ANDROID_URL=
SELLER_IOS_URL=

# ---- CJdropshipping (optional) ----
# Products from CJ ship straight to the customer. Kinan creates and pays the CJ order from your CJ balance.
# CJ account → Authorization → API → generate the API key. Test payments always make CJ *sandbox* orders.
CJ_API_KEY=
# CJ_FALLBACK_SHIPPING=8      # shipping charged if CJ's price service is down
# CJ_SANDBOX=1                # make every CJ order a sandbox order (for testing with real payments off)

# AI: product review and listing assistant. GEMINI_API_KEY is free from aistudio.google.com (used first);
# ANTHROPIC_API_KEY (console.anthropic.com) is paid. With either key every product is reviewed automatically.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini            # or claude, when both keys are set
# AI_AUTO_REVIEW=off            # stop the automatic review
# AI_REVIEW_DAILY=300           # products reviewed per day at most
